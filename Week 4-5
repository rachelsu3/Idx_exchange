def check_geographic_data(df, name):
    print(f"\n{name} - Geographic quality checks:")
    
    # Flag columns
    df['missing_coordinates_flag'] = 0
    df['zero_coordinates_flag'] = 0
    df['longitude_error_flag'] = 0
    df['out_of_state_flag'] = 0
    
    # Check missing coordinates
    if 'Latitude' in df.columns and 'Longitude' in df.columns:
        missing = df['Latitude'].isnull() | df['Longitude'].isnull()
        df.loc[missing, 'missing_coordinates_flag'] = 1
        print(f"   - Missing coordinates: {missing.sum():,} records flagged")
    
    # Check Latitude = 0 or Longitude = 0 (sentinel null values)
    if 'Latitude' in df.columns and 'Longitude' in df.columns:
        zero_coords = ((df['Latitude'] == 0) | (df['Longitude'] == 0)) & (~missing)
        df.loc[zero_coords, 'zero_coordinates_flag'] = 1
        print(f"   - Zero coordinates (sentinel values): {zero_coords.sum():,} records flagged")
    
    # Check Longitude > 0 error (California coordinates should be negative)
    if 'Longitude' in df.columns:
        long_error = (df['Longitude'] > 0) & (df['Longitude'].notna()) & (df['Longitude'] != 0)
        df.loc[long_error, 'longitude_error_flag'] = 1
        print(f"   - Longitude > 0 (should be negative for CA): {long_error.sum():,} records flagged")
    
    # Check out-of-state or implausible coordinates (rough California bounds)
    if 'Latitude' in df.columns and 'Longitude' in df.columns:
        # California approximate bounds: Lat 32.5-42.0, Long -124.5 to -114.0
        out_of_state = ((df['Latitude'] < 32) | (df['Latitude'] > 42) | 
                        (df['Longitude'] < -125) | (df['Longitude'] > -113)) & \
                       (df['Latitude'].notna()) & (df['Longitude'].notna()) & \
                       (~zero_coords) & (~missing)
        df.loc[out_of_state, 'out_of_state_flag'] = 1
        print(f"   - Out-of-state coordinates: {out_of_state.sum():,} records flagged")
    
    return df

