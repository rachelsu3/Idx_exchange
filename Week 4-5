def flag_invalid_values(df, name):
    print(f"\n{name} - Invalid value flags:")
    
    # Create flag columns for invalid values
    df['invalid_close_price_flag'] = 0
    df['invalid_living_area_flag'] = 0
    df['invalid_dom_flag'] = 0
    df['invalid_bedrooms_flag'] = 0
    df['invalid_bathrooms_flag'] = 0
    
    # Flag ClosePrice <= 0
    if 'ClosePrice' in df.columns:
        invalid = (df['ClosePrice'] <= 0) | (df['ClosePrice'].isnull())
        df.loc[invalid, 'invalid_close_price_flag'] = 1
        print(f"   - ClosePrice <= 0: {invalid.sum():,} records flagged")
    
    # Flag LivingArea <= 0
    if 'LivingArea' in df.columns:
        invalid = (df['LivingArea'] <= 0) | (df['LivingArea'].isnull())
        df.loc[invalid, 'invalid_living_area_flag'] = 1
        print(f"   - LivingArea <= 0: {invalid.sum():,} records flagged")
    
    # Flag DaysOnMarket < 0
    if 'DaysOnMarket' in df.columns:
        invalid = (df['DaysOnMarket'] < 0) | (df['DaysOnMarket'].isnull())
        df.loc[invalid, 'invalid_dom_flag'] = 1
        print(f"   - DaysOnMarket < 0: {invalid.sum():,} records flagged")
    
    # Flag Bedrooms < 0 or > 10 (unrealistic)
    if 'BedroomsTotal' in df.columns:
        invalid = (df['BedroomsTotal'] < 0) | (df['BedroomsTotal'] > 10) | (df['BedroomsTotal'].isnull())
        df.loc[invalid, 'invalid_bedrooms_flag'] = 1
        print(f"   - Bedrooms out of range (0-10): {invalid.sum():,} records flagged")
    
    # Flag Bathrooms < 0 or > 10
    if 'BathroomsTotalInteger' in df.columns:
        invalid = (df['BathroomsTotalInteger'] < 0) | (df['BathroomsTotalInteger'] > 10) | (df['BathroomsTotalInteger'].isnull())
        df.loc[invalid, 'invalid_bathrooms_flag'] = 1
        print(f"   - Bathrooms out of range (0-10): {invalid.sum():,} records flagged")
    
    return df

