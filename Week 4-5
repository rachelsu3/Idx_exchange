# Identify columns that are all null or have very high missing rates (>95%)
def remove_high_missing_columns(df, name, threshold=95):
    missing_pct = (df.isnull().sum() / len(df)) * 100
    cols_to_drop = missing_pct[missing_pct > threshold].index.tolist()
    
    if cols_to_drop:
        print(f"\n{name} - Dropping {len(cols_to_drop)} columns with >{threshold}% missing:")
        for col in cols_to_drop[:10]:
            print(f"   - {col}: {missing_pct[col]:.1f}% missing")
        if len(cols_to_drop) > 10:
            print(f"   ... and {len(cols_to_drop) - 10} more")
        return df.drop(columns=cols_to_drop)
    else:
        print(f"\n{name} - No columns with >{threshold}% missing")
        return df

# Remove redundant columns (duplicate or identifier columns that don't add value)
redundant_patterns = ['MLS_Number', 'ListingId', 'Id', 'Unnamed', 'OriginatingSystemKey', 'OriginatingSystemID']

def remove_redundant_columns(df, name):
    cols_to_drop = []
    for col in df.columns:
        for pattern in redundant_patterns:
            if pattern.lower() in col.lower():
                cols_to_drop.append(col)
                break
    
    df_cleaned = df.drop(columns=cols_to_drop, errors='ignore')
    
    if cols_to_drop:
        print(f"\n{name} - Dropped {len(cols_to_drop)} redundant columns: {cols_to_drop[:5]}")
        if len(cols_to_drop) > 5:
            print(f"   ... and {len(cols_to_drop) - 5} more")
    
    return df_cleaned

