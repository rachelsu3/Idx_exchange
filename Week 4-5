# Function to handle missing values based on column type
def handle_missing_values(df, name):
    print(f"\n{name} - Missing value handling:")
    
    # Numeric fields: fill with median
    numeric_fields = ['ClosePrice', 'ListPrice', 'LivingArea', 'LotSizeAcres', 
                      'BedroomsTotal', 'BathroomsTotalInteger', 'DaysOnMarket', 
                      'YearBuilt', 'rate_30yr_fixed']
    
    for field in numeric_fields:
        if field in df.columns:
            missing_count = df[field].isnull().sum()
            if missing_count > 0:
                median_val = df[field].median()
                df[field].fillna(median_val, inplace=True)
                print(f"   - {field}: filled {missing_count:,} missing values with median ({median_val:.2f})")
    
    # Categorical fields: fill with mode or 'Unknown'
    categorical_fields = ['PropertyType', 'County', 'City', 'PropertySubType']
    for field in categorical_fields:
        if field in df.columns:
            missing_count = df[field].isnull().sum()
            if missing_count > 0:
                mode_val = df[field].mode()[0] if len(df[field].mode()) > 0 else 'Unknown'
                df[field].fillna(mode_val, inplace=True)
                print(f"   - {field}: filled {missing_count:,} missing values with '{mode_val}'")
    
    return df

df_sold = handle_missing_values(df_sold, "Sold Data")
